# RideFlow Database & Server Environment Configuration
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080

# MySQL 8.x Configuration (Default fallback to in-memory H2 in MySQL mode if MySQL is offline)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rideflow_db
DB_USERNAME=rideflow_user
DB_PASSWORD=rideflow_secret

# Simulation Defaults
SIMULATION_DEFAULT_SCENARIO=NORMAL_DEMAND
SIMULATION_DEFAULT_SEED=42
SIMULATION_TICK_RATE_MS=1000
